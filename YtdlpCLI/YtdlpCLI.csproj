<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>ytdlp-cli</AssemblyName>
        <Version>0.2.0</Version>
        <RootNamespace>YtdlpCLI</RootNamespace>
        <InvariantGlobalization>true</InvariantGlobalization>
        <!-- Linux / macOS 向けに publish するときも実行ファイル名を揃える -->
        <UseAppHost>true</UseAppHost>
    </PropertyGroup>

    <ItemGroup>
        <!-- yt-dlp / ffmpeg は ToolProvisioner が実行時に取得するので、
             Windows 専用バイナリを同梱する ytdlp-executable は参照しない -->
        <PackageReference Include="Ytdlp.NET" Version="2.1.1" />
        <!-- Linux 版 ffmpeg (tar.xz) の展開に使用 -->
        <PackageReference Include="SharpCompress" Version="1.0.0" />
    </ItemGroup>

</Project>
